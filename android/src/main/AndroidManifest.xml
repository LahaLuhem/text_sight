<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <!-- No `com.google.mlkit.vision.DEPENDENCIES` meta-data, which would download the model for
         every app at install. The app picks the moment with TextSightModel.ensureReady(), or adds
         the meta-data itself to fetch at install. -->
</manifest>
